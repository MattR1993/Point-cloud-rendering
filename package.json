{
  "name": "point-cloud-rendering",
  "version": "1.0.0",
  "description": "Desktop flythrough video creator for point clouds and 3D models.",
  "main": "dist/main/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:main\" \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "dev:renderer": "webpack serve --config webpack.config.js --mode development",
    "dev:electron": "wait-on tcp:3000 dist/main/electron/main.js && electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "webpack --config webpack.config.js --mode production",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json"
  },
  "repository": {
    "type": "git",
    "url": "http://localhost:26831/MattR1993/Point-cloud-rendering"
  },
  "keywords": [
    "electron",
    "react",
    "threejs",
    "point-cloud",
    "flythrough"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "concurrently": "^10.0.5",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "html-webpack-plugin": "^5.6.8",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.2",
    "wait-on": "^9.1.0",
    "webpack": "^5.110.3",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  }
}
